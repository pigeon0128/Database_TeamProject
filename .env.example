# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# PostgreSQL 접속 주소: postgres://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgres://postgres:비밀번호@localhost:5432/doroland_drawing

# 로그인 쿠키 서명용 비밀 값 (아무 긴 무작위 문자열)
SESSION_SECRET=여기에-아무-긴-무작위-문자열

# API 서버 포트 (Vite 개발 서버가 /api 요청을 이 포트로 넘깁니다)
API_PORT=3001
