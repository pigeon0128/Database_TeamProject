# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)

# PostgreSQL 접속 주소: postgres://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgres://postgres:비밀번호@localhost:5432/doroland_drawing

# 로그인 쿠키 서명용 비밀 값 (아무 긴 무작위 문자열)
SESSION_SECRET=여기에-아무-긴-무작위-문자열

# API 서버 포트 (Vite 개발 서버가 /api 요청을 이 포트로 넘깁니다)
API_PORT=3001

# (선택) 완성 그림 파일을 둘 폴더. 비워 두면 프로젝트의 uploads/ 폴더를 쓴다
# UPLOAD_DIR=

# (선택) localhost Vite 개발 서버의 #/myroom만 로그인 없이 Preview (Mock 작품/로컬 저장)
# true로 바꾼 뒤 Vite를 재시작하세요. production build에서는 항상 비활성화됩니다.
VITE_MYROOM_PREVIEW=false

# (선택) AI 밑그림 (캐릭터 그리기의 "AI 밑그림" 버튼). https://platform.openai.com/api-keys 에서 만든 키를 넣고 API 서버를 다시 켜세요.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=low
# 밑그림 한 장에 드는 셀 (기본 50)
# AI_SKETCH_CELLS=50
# AI 그림 연습실(#/ai-studio) 그림 한 장에 드는 셀 (기본 50)
# AI_IMAGE_CELLS=50
# AI 조언(캐릭터 그리기의 "조언 받기") 한 번에 드는 셀 (기본 10)
# AI_ADVICE_CELLS=10
# 그림을 보고 조언하는 모델 (기본 gpt-5.4-mini)
# OPENAI_ADVICE_MODEL=gpt-5.4-mini
